# ── Azure AI Search ──────────────────────────────────────────────────
# The search service where the demo index + knowledge base will be created.
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
# Auth: "token" (DefaultAzureCredential) or "key" (API key)
AZURE_SEARCH_AUTH_TYPE=token
# Only needed when AUTH_TYPE=key:
AZURE_SEARCH_API_KEY=

# ── Azure OpenAI (used by the knowledge base for query planning / answer synthesis) ─
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_KEY=
# Auth: "entra" (DefaultAzureCredential) or "key" (API key)
AZURE_OPENAI_AUTH_TYPE=entra
